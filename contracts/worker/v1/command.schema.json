{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Engineering Lab worker v1 command",
  "type": "object",
  "required": [
    "protocolVersion",
    "runId",
    "experimentId",
    "parameters",
    "definitionSha256",
    "deadlineEpochMs",
    "seed",
    "workspace"
  ],
  "properties": {
    "protocolVersion": {
      "const": 1
    },
    "runId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 100,
      "pattern": "^[a-zA-Z0-9._-]{1,100}$"
    },
    "experimentId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 100,
      "pattern": "^[a-zA-Z0-9._-]{1,100}$"
    },
    "parameters": {
      "type": "object",
      "maxProperties": 64,
      "propertyNames": {
        "type": "string",
        "minLength": 1,
        "maxLength": 100
      },
      "additionalProperties": {
        "oneOf": [
          {
            "type": "string",
            "minLength": 0,
            "maxLength": 4096
          },
          {
            "type": "number"
          },
          {
            "type": "boolean"
          }
        ]
      }
    },
    "definitionSha256": {
      "type": "string",
      "minLength": 64,
      "maxLength": 64,
      "pattern": "^[a-f0-9]{64}$"
    },
    "deadlineEpochMs": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9223372036854775807
    },
    "seed": {
      "type": "integer",
      "minimum": -9223372036854775808,
      "maximum": 9223372036854775807
    },
    "workspace": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096,
      "pattern": "^[^\\u0000]+$"
    }
  },
  "additionalProperties": false
}
