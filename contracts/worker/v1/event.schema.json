{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Engineering Lab worker v1 event",
  "oneOf": [
    {
      "type": "object",
      "required": [
        "protocolVersion",
        "runId",
        "sequence",
        "type",
        "payload"
      ],
      "properties": {
        "protocolVersion": {
          "const": 1
        },
        "runId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100,
          "pattern": "^[a-zA-Z0-9._-]{1,100}$"
        },
        "sequence": {
          "type": "integer",
          "minimum": 0,
          "maximum": 99999
        },
        "type": {
          "const": "HELLO"
        },
        "payload": {
          "type": "object",
          "required": [
            "moduleId",
            "experimentId",
            "definitionSha256",
            "artifactSha256",
            "environment",
            "git"
          ],
          "properties": {
            "moduleId": {
              "type": "string",
              "minLength": 1,
              "maxLength": 100,
              "pattern": "^[a-zA-Z0-9._-]{1,100}$"
            },
            "experimentId": {
              "type": "string",
              "minLength": 1,
              "maxLength": 100,
              "pattern": "^[a-zA-Z0-9._-]{1,100}$"
            },
            "definitionSha256": {
              "type": "string",
              "minLength": 64,
              "maxLength": 64,
              "pattern": "^[a-f0-9]{64}$"
            },
            "artifactSha256": {
              "type": "string",
              "minLength": 64,
              "maxLength": 64,
              "pattern": "^[a-f0-9]{64}$"
            },
            "environment": {
              "type": "object",
              "required": [
                "javaVersion",
                "javaVendor",
                "vmName",
                "osName",
                "osVersion",
                "osArch",
                "availableProcessors",
                "maxHeapBytes"
              ],
              "properties": {
                "javaVersion": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 256
                },
                "javaVendor": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 256
                },
                "vmName": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 256
                },
                "osName": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 256
                },
                "osVersion": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 256
                },
                "osArch": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 256
                },
                "availableProcessors": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 2147483647
                },
                "maxHeapBytes": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 9223372036854775807
                }
              },
              "additionalProperties": false
            },
            "git": {
              "type": "object",
              "required": [
                "commit",
                "dirty",
                "error"
              ],
              "properties": {
                "commit": {
                  "anyOf": [
                    {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 128
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "dirty": {
                  "anyOf": [
                    {
                      "type": "boolean"
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "error": {
                  "anyOf": [
                    {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 1024
                    },
                    {
                      "type": "null"
                    }
                  ]
                }
              },
              "additionalProperties": false
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    {
      "type": "object",
      "required": [
        "protocolVersion",
        "runId",
        "sequence",
        "type",
        "payload"
      ],
      "properties": {
        "protocolVersion": {
          "const": 1
        },
        "runId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100,
          "pattern": "^[a-zA-Z0-9._-]{1,100}$"
        },
        "sequence": {
          "type": "integer",
          "minimum": 0,
          "maximum": 99999
        },
        "type": {
          "const": "PHASE"
        },
        "payload": {
          "type": "object",
          "required": [
            "phase"
          ],
          "properties": {
            "phase": {
              "type": "string",
              "enum": [
                "PREPARING",
                "MEASURING",
                "FINALIZING"
              ]
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    {
      "type": "object",
      "required": [
        "protocolVersion",
        "runId",
        "sequence",
        "type",
        "payload"
      ],
      "properties": {
        "protocolVersion": {
          "const": 1
        },
        "runId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100,
          "pattern": "^[a-zA-Z0-9._-]{1,100}$"
        },
        "sequence": {
          "type": "integer",
          "minimum": 0,
          "maximum": 99999
        },
        "type": {
          "const": "METRIC"
        },
        "payload": {
          "type": "object",
          "required": [
            "timestampEpochMs",
            "gauges",
            "counters",
            "labels"
          ],
          "properties": {
            "timestampEpochMs": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9223372036854775807
            },
            "gauges": {
              "type": "object",
              "maxProperties": 64,
              "propertyNames": {
                "type": "string",
                "minLength": 1,
                "maxLength": 100,
                "pattern": "^[a-zA-Z0-9._-]{1,100}$"
              },
              "additionalProperties": {
                "type": "number"
              }
            },
            "counters": {
              "type": "object",
              "maxProperties": 64,
              "propertyNames": {
                "type": "string",
                "minLength": 1,
                "maxLength": 100,
                "pattern": "^[a-zA-Z0-9._-]{1,100}$"
              },
              "additionalProperties": {
                "type": "integer",
                "minimum": -9223372036854775808,
                "maximum": 9223372036854775807
              }
            },
            "labels": {
              "type": "object",
              "maxProperties": 64,
              "propertyNames": {
                "type": "string",
                "minLength": 1,
                "maxLength": 100,
                "pattern": "^[a-zA-Z0-9._-]{1,100}$"
              },
              "additionalProperties": {
                "type": "string",
                "minLength": 0,
                "maxLength": 256
              }
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    {
      "type": "object",
      "required": [
        "protocolVersion",
        "runId",
        "sequence",
        "type",
        "payload"
      ],
      "properties": {
        "protocolVersion": {
          "const": 1
        },
        "runId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100,
          "pattern": "^[a-zA-Z0-9._-]{1,100}$"
        },
        "sequence": {
          "type": "integer",
          "minimum": 0,
          "maximum": 99999
        },
        "type": {
          "const": "CHECK"
        },
        "payload": {
          "type": "object",
          "required": [
            "checkId",
            "status",
            "expected",
            "observed",
            "description"
          ],
          "properties": {
            "checkId": {
              "type": "string",
              "minLength": 1,
              "maxLength": 100,
              "pattern": "^[a-zA-Z0-9._-]{1,100}$"
            },
            "status": {
              "type": "string",
              "enum": [
                "PASS",
                "FAIL"
              ]
            },
            "expected": {
              "type": "string",
              "minLength": 0,
              "maxLength": 4096
            },
            "observed": {
              "type": "string",
              "minLength": 0,
              "maxLength": 4096
            },
            "description": {
              "type": "string",
              "minLength": 0,
              "maxLength": 4096
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    {
      "type": "object",
      "required": [
        "protocolVersion",
        "runId",
        "sequence",
        "type",
        "payload"
      ],
      "properties": {
        "protocolVersion": {
          "const": 1
        },
        "runId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100,
          "pattern": "^[a-zA-Z0-9._-]{1,100}$"
        },
        "sequence": {
          "type": "integer",
          "minimum": 0,
          "maximum": 99999
        },
        "type": {
          "const": "ARTIFACT"
        },
        "payload": {
          "type": "object",
          "required": [
            "path",
            "sizeBytes",
            "sha256",
            "kind"
          ],
          "properties": {
            "path": {
              "type": "string",
              "minLength": 1,
              "maxLength": 1024,
              "pattern": "^(?!/)(?!.*[\\\\:\\u0000])(?!.*(?:^|/)(?:\\.|\\.\\.)(?:/|$))[^/]+(?:/[^/]+)*$"
            },
            "sizeBytes": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9223372036854775807
            },
            "sha256": {
              "type": "string",
              "minLength": 64,
              "maxLength": 64,
              "pattern": "^[a-f0-9]{64}$"
            },
            "kind": {
              "type": "string",
              "enum": [
                "JFR",
                "LOG",
                "REPORT"
              ]
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    {
      "type": "object",
      "required": [
        "protocolVersion",
        "runId",
        "sequence",
        "type",
        "payload"
      ],
      "properties": {
        "protocolVersion": {
          "const": 1
        },
        "runId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100,
          "pattern": "^[a-zA-Z0-9._-]{1,100}$"
        },
        "sequence": {
          "type": "integer",
          "minimum": 0,
          "maximum": 99999
        },
        "type": {
          "const": "RESULT"
        },
        "payload": {
          "type": "object",
          "required": [
            "status",
            "reason",
            "summary",
            "lastSequence",
            "counts"
          ],
          "properties": {
            "status": {
              "type": "string",
              "enum": [
                "SUCCEEDED",
                "FAILED",
                "INTERRUPTED"
              ]
            },
            "reason": {
              "type": "string",
              "minLength": 0,
              "maxLength": 1024
            },
            "summary": {
              "type": "object",
              "maxProperties": 64,
              "propertyNames": {
                "type": "string",
                "minLength": 1,
                "maxLength": 100
              },
              "additionalProperties": {
                "oneOf": [
                  {
                    "type": "string",
                    "minLength": 0,
                    "maxLength": 4096
                  },
                  {
                    "type": "number"
                  },
                  {
                    "type": "boolean"
                  }
                ]
              }
            },
            "lastSequence": {
              "type": "integer",
              "minimum": 1,
              "maximum": 99999
            },
            "counts": {
              "type": "object",
              "required": [
                "HELLO",
                "PHASE",
                "METRIC",
                "CHECK",
                "ARTIFACT"
              ],
              "properties": {
                "HELLO": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 99999
                },
                "PHASE": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 99999
                },
                "METRIC": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 99999
                },
                "CHECK": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 99999
                },
                "ARTIFACT": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 99999
                }
              },
              "additionalProperties": false
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    }
  ]
}
