{
  "name": "engineering-lab-dashboard",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": "24.19.0",
    "npm": "11.6.0"
  },
  "packageManager": "npm@11.6.0",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "build": "npm run typecheck && vite build",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "preview": "vite preview --host 127.0.0.1",
    "serve": "node server/serve.mjs",
    "test:serve": "node --test server/serve.test.mjs"
  },
  "dependencies": {
    "@radix-ui/react-icons": "1.3.2",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/node": "26.6.4",
    "typescript": "7.0.2",
    "vite": "8.3.2",
    "vitest": "5.0.3",
    "@playwright/test": "1.63.0"
  }
}
